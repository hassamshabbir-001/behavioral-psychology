---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date?: string; // ISO date for dateModified
  heroImage: string;
  heroAlt: string;
  heroWidth?: number;
  heroHeight?: number;
  deck?: string;
  crumbs?: { label: string; href?: string }[];
  faqs?: { q: string; a: string }[];
  explore?: { title: string; href: string; description: string }[];
}

const {
  title, description, date = "2026-11-03",
  heroImage, heroAlt, heroWidth = 1168, heroHeight = 784,
  deck = "", crumbs = [], faqs = [], explore = [],
} = Astro.props;

const site = 'https://behavioralpsychology.pro';
const pageUrl = new URL(Astro.url.pathname, site).href;

const crumbItems = [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": site + "/" },
  ...crumbs.map((c, i) => ({
    "@type": "ListItem",
    "position": i + 2,
    "name": c.label,
    ...(c.href ? { "item": new URL(c.href, site).href } : { "item": pageUrl }),
  })),
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": pageUrl + "#webpage",
      "url": pageUrl,
      "name": title,
      "description": description,
      "dateModified": date,
      "author": { "@type": "Person", "name": "Hassam Shabbir", "url": site + "/author/hassam-shabbir/" },
      "publisher": { "@type": "Organization", "name": "Behavioral Psychology", "url": site + "/" },
      "isPartOf": { "@id": site + "/#website" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": crumbItems,
    },
    ...(faqs.length > 0 ? [{
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }] : [])
  ]
};
---
<BaseLayout title={title} description={description} ogImage={heroImage} jsonLd={jsonLd}>
  <style>
    .hub-body { background: #fff; padding: 12px 0 88px; }
    .hub-faq { max-width: 860px; margin: 64px auto 0; }
    .hub-faq h2 { font-size: 30px; color: var(--navy); font-weight: 800; letter-spacing: -0.4px; margin: 0 0 22px; }
    .explore-band { background: var(--bg); border-top: 1px solid var(--line); padding: 72px 0; }
    .explore-band h2 { font-size: 30px; color: var(--navy); font-weight: 800; letter-spacing: -0.4px; margin: 0 0 12px; text-align: center; }
    .explore-band > .wrap > p { text-align: center; color: var(--muted); margin: 0 0 36px; font-size: 16px; }
    @media (max-width: 820px) {
      .hub-body { padding-bottom: 64px; }
    }
  </style>

  <section class="inner-hero">
    <div class="wrap inner-hero-grid">
      <div class="inner-hero-copy">
        <p class="crumbs">
          <a href="/">Home</a>
          {crumbs.map((c) => (<Fragment> &rsaquo; {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</Fragment>))}
        </p>
        <span class="pill-badge">Guide Hub</span>
        <h1 style="margin-top: 16px;">{title}</h1>
        {deck && <p class="lead">{deck}</p>}
      </div>
      <div class="hero-media">
        <div class="hero-photo">
          <img src={heroImage} alt={heroAlt} width={heroWidth} height={heroHeight} fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>

  <div class="hub-body">
    <div class="wrap">
      <div class="prose">
        <slot />
      </div>
      {faqs.length > 0 && (
        <section class="hub-faq" aria-label="Frequently asked questions">
          <h2>Frequently asked questions</h2>
          <div class="faq-list single">
            {faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <div class="faq-answer"><p>{f.a}</p></div>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>

  {explore.length > 0 && (
    <section class="explore-band" aria-label="Keep exploring">
      <div class="wrap">
        <h2>Keep exploring</h2>
        <p>Related guides from this hub.</p>
        <div class="card-grid">
          {explore.map((e) => (
            <a class="card" href={e.href}>
              <div class="card-body">
                <h3>{e.title}</h3>
                <p>{e.description}</p>
                <span class="card-link">Read the guide
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
