---
interface NavChild { label: string; href: string; }
interface NavItem { label: string; href: string; children?: NavChild[]; }
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  articleDate?: string;
  jsonLd?: Record<string, unknown>;
}
const {
  title, description,
  ogImage = '/images/og-cover.jpg',
  ogType = 'website', articleDate, jsonLd,
} = Astro.props;
const site = 'https://behavioralpsychology.pro';
const canonical = new URL(Astro.url.pathname, site).href;
const ogAbsolute = new URL(ogImage, site).href;
const nav: NavItem[] = [
  { label: 'Home', href: '/' },
  {
    label: 'Degrees', href: '/degrees/',
    children: [
      { label: 'Overview', href: '/degrees/' },
      { label: 'MS in Behavioral Psychology', href: '/degrees/ms-behavioral-psychology/' },
      { label: 'Online Degree Programs', href: '/degrees/online-behavioral-psychology-degree/' },
      { label: "Master's Programs Guide", href: '/degrees/masters-in-behavioral-psychology/' },
      { label: 'PhD Programs and Careers', href: '/degrees/phd-in-behavioral-psychology/' },
    ],
  },
  {
    label: 'Careers', href: '/careers/',
    children: [
      { label: 'Overview', href: '/careers/' },
    ],
  },
  {
    label: 'Articles', href: '/blog/',
    children: [
      { label: 'What Is Behavioral Psychology?', href: '/what-is-behavioral-psychology/' },
      { label: 'The Behavioral Perspective', href: '/behavioral-perspective-psychology/' },
      { label: 'Everyday Examples', href: '/behavioral-psychology-examples/' },
      { label: 'Behavioral Science vs Psychology', href: '/behavioral-science-vs-psychology/' },
      { label: 'All Articles', href: '/blog/' },
    ],
  },
  { label: 'About', href: '/about/' },
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#7C5CFC" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Behavioral Psychology" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogAbsolute} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Behavioral Psychology" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogAbsolute} />
  {articleDate && (<><meta property="article:published_time" content={articleDate} /><meta property="article:author" content="Hassam Shabbir" /></>)}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
  <style is:global>
    :root {
      --purple: #8B7CF6;
      --purple-deep: #7C5CFC;
      --purple-dark: #6847E8;
      --purple-soft: #EFEAFF;
      --purple-line: #DCD4FF;
      --navy: #191B2A;
      --ink: #2A2D42;
      --muted: #5F6379;
      --line: #E7E6F2;
      --bg: #F6F6FB;
      --card: #FFFFFF;
      --radius: 20px;
      --shadow: 0 18px 40px rgba(25, 27, 42, 0.08);
      --shadow-sm: 0 8px 24px rgba(25, 27, 42, 0.07);
      --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: var(--font);
      color: var(--ink);
      line-height: 1.6;
      background: var(--bg);
      -webkit-font-smoothing: antialiased;
    }
    img { display: block; max-width: 100%; }
    .wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
    a { color: var(--purple-deep); }

    /* ---------- Header ---------- */
    .site-header {
      position: sticky; top: 0; z-index: 50;
      background: #fff;
      border-bottom: 1px solid var(--line);
    }
    .header-inner { display: flex; align-items: center; gap: 28px; height: 78px; }
    .brand {
      display: inline-flex; align-items: center; gap: 10px;
      text-decoration: none; flex: none;
    }
    .brand svg { width: 34px; height: 34px; flex: none; }
    .brand img.logo-img { height: 46px; width: auto; }
    .logo-badge {
      display: inline-block; background: #fff; border-radius: 16px;
      padding: 10px 18px; line-height: 0;
    }
    .logo-badge img { height: 42px; width: auto; }
    .brand-name { font-size: 19px; font-weight: 800; color: var(--navy); letter-spacing: -0.3px; line-height: 1.1; }
    .brand-name span { color: var(--purple-deep); }
    .main-nav { margin-left: auto; }
    .main-nav ul {
      display: flex; align-items: center; gap: 24px;
      list-style: none; margin: 0; padding: 0;
    }
    .main-nav > ul > li > a {
      color: var(--ink); text-decoration: none;
      font-size: 14.5px; font-weight: 600;
      padding: 8px 2px; position: relative;
    }
    .main-nav > ul > li > a:hover { color: var(--purple-deep); }
    .main-nav > ul > li > a.active { color: var(--navy); }
    .main-nav > ul > li > a.active::after {
      content: ""; position: absolute; left: 0; right: 0; bottom: 2px;
      height: 3px; border-radius: 2px; background: var(--purple-deep);
    }
    .main-nav li.has-dropdown { position: relative; display: inline-flex; align-items: center; gap: 4px; }
    .sub-toggle {
      display: inline-flex; background: none; border: none; cursor: pointer;
      color: inherit; padding: 8px 4px; line-height: 0; border-radius: 8px;
    }
    .sub-toggle svg { width: 13px; height: 13px; transition: transform .2s ease; }
    .sub-toggle:hover { color: var(--purple-deep); }
    .main-nav .dropdown {
      display: none;
      position: absolute; top: 100%; left: -10px;
      background: #fff; border: 1px solid var(--line); border-radius: 16px;
      box-shadow: var(--shadow);
      min-width: 260px; padding: 10px; z-index: 60;
      list-style: none; margin: 8px 0 0;
    }
    .main-nav .dropdown::before {
      content: ""; position: absolute; top: -10px; left: 0; right: 0; height: 10px;
    }
    .main-nav li.has-dropdown:hover > .dropdown,
    .main-nav li.has-dropdown:focus-within > .dropdown { display: block; }
    .main-nav .dropdown a {
      display: block; padding: 10px 14px;
      font-size: 14px; font-weight: 600; border-radius: 10px;
      color: var(--ink); text-decoration: none;
    }
    .main-nav .dropdown a:hover { background: var(--purple-soft); color: var(--purple-dark); }
    .header-actions { display: flex; align-items: center; gap: 12px; margin-left: auto; }
    .menu-toggle {
      display: none; background: none; border: 1px solid var(--line);
      border-radius: 10px; padding: 8px 10px; cursor: pointer; color: var(--navy);
    }
    .menu-toggle svg { width: 22px; height: 22px; display: block; }

    /* ---------- Buttons & pills ---------- */
    .btn {
      display: inline-flex; align-items: center; gap: 10px;
      border-radius: 999px; padding: 14px 32px;
      font-size: 15px; font-weight: 700; text-decoration: none;
      transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.15s;
      cursor: pointer; border: 2px solid transparent; font-family: var(--font);
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-purple { background: var(--purple-deep); color: #fff; }
    .btn-purple:hover { background: var(--purple-dark); }
    .btn-outline { background: #fff; color: var(--navy); border-color: var(--line); }
    .btn-outline:hover { border-color: var(--purple-deep); color: var(--purple-deep); }
    .btn-sm { padding: 10px 24px; font-size: 14px; }
    .btn svg { width: 16px; height: 16px; }
    .pill-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--purple-soft); color: var(--purple-dark);
      border-radius: 999px; padding: 8px 18px;
      font-size: 13px; font-weight: 700;
    }
    .kicker {
      display: inline-block; background: var(--purple-soft); color: var(--purple-dark);
      border-radius: 999px; padding: 7px 18px;
      font-size: 12.5px; font-weight: 700; letter-spacing: 0.4px;
      margin: 0 0 14px;
    }

    /* ---------- Hero (homepage) ---------- */
    .hero { position: relative; overflow: hidden; background: #fff; }
    .hero-hex {
      position: absolute; inset: 0; pointer-events: none; opacity: 0.55;
    }
    .hero-grid {
      position: relative; z-index: 2;
      display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center;
      padding-block: 84px 96px;
    }
    .hero-copy h1 {
      font-size: 54px; line-height: 1.1; letter-spacing: -1px;
      margin: 18px 0 18px; color: var(--navy); font-weight: 800;
    }
    .hero-copy h1 .accent { color: var(--purple-deep); }
    .hero-copy p.lead { font-size: 17.5px; color: var(--muted); margin: 0 0 32px; max-width: 480px; }
    .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
    .hero-media { position: relative; }
    .hero-photo {
      border-radius: 28px; overflow: hidden; box-shadow: var(--shadow);
      border: 6px solid #fff;
    }
    .hero-photo img { width: 100%; height: auto; aspect-ratio: 4 / 3.4; object-fit: cover; }
    .float-chip {
      position: absolute; display: inline-flex; align-items: center; gap: 10px;
      background: #fff; border-radius: 999px; padding: 12px 20px 12px 14px;
      box-shadow: var(--shadow-sm); font-size: 13.5px; font-weight: 700; color: var(--navy);
      border: 1px solid var(--line);
    }
    .float-chip .chip-icon {
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--purple-soft); color: var(--purple-deep);
      display: inline-flex; align-items: center; justify-content: center; flex: none;
    }
    .float-chip .chip-icon svg { width: 17px; height: 17px; }
    .float-chip.chip-1 { left: -24px; bottom: 88px; }
    .float-chip.chip-2 { right: -14px; bottom: 26px; }
    .hero-dots { display: flex; gap: 8px; justify-content: center; margin-top: 22px; }
    .hero-dots span { height: 8px; border-radius: 4px; background: var(--line); }
    .hero-dots span.on { width: 44px; background: var(--purple-deep); }
    .hero-dots span:not(.on) { width: 22px; }

    /* ---------- Sections ---------- */
    .section { padding: 88px 0; }
    .section.white { background: #fff; }
    .section-head { text-align: center; max-width: 680px; margin: 0 auto 52px; }
    .section-head h2 {
      font-size: 36px; color: var(--navy); margin: 0 0 12px;
      font-weight: 800; letter-spacing: -0.6px; line-height: 1.2;
    }
    .section-head p { color: var(--muted); margin: 0; font-size: 16.5px; }

    /* Topics grid (portrait cards, grayscale like reference) */
    .topic-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
    .topic-card {
      position: relative; border-radius: var(--radius); overflow: hidden;
      text-decoration: none; display: block; box-shadow: var(--shadow-sm);
      transition: transform 0.2s, box-shadow 0.2s;
      background: #fff;
    }
    .topic-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
    .topic-card img {
      width: 100%; height: auto; aspect-ratio: 4 / 4.6; object-fit: cover;
      filter: grayscale(1);
    }
    .topic-card .topic-label {
      position: absolute; left: 16px; bottom: 16px;
      background: rgba(255,255,255,0.96); color: var(--navy);
      border-radius: 999px; padding: 9px 18px;
      font-size: 13.5px; font-weight: 700;
      display: inline-flex; align-items: center; gap: 8px;
    }
    .topic-card .topic-label svg { width: 15px; height: 15px; color: var(--purple-deep); }

    /* How we research */
    .research-grid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: 64px; align-items: center; }
    .research-media img {
      width: 100%; height: auto; aspect-ratio: 4 / 3.2; object-fit: cover;
      border-radius: 24px; box-shadow: var(--shadow);
    }
    .research-copy h2 {
      font-size: 34px; color: var(--navy); font-weight: 800;
      letter-spacing: -0.5px; margin: 0 0 16px; line-height: 1.22;
    }
    .research-copy > p { color: var(--muted); font-size: 16.5px; margin: 0 0 28px; }
    .check-list { list-style: none; margin: 0 0 30px; padding: 0; display: grid; gap: 16px; }
    .check-list li { display: flex; gap: 14px; align-items: flex-start; font-size: 15.5px; color: var(--ink); }
    .check-list .check {
      width: 30px; height: 30px; border-radius: 50%; flex: none;
      background: var(--purple-soft); color: var(--purple-deep);
      display: inline-flex; align-items: center; justify-content: center; margin-top: 1px;
    }
    .check-list .check svg { width: 15px; height: 15px; }
    .check-list strong { color: var(--navy); }

    /* Article cards */
    .card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
    .card {
      background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
      overflow: hidden; display: flex; flex-direction: column; text-decoration: none;
      transition: box-shadow 0.2s, transform 0.2s;
    }
    .card:hover { box-shadow: var(--shadow); transform: translateY(-4px); }
    .card img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
    .card-body { padding: 24px 26px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
    .card-body .card-kicker { font-size: 12px; font-weight: 800; letter-spacing: 1px; color: var(--purple-deep); text-transform: uppercase; }
    .card-body h3 { margin: 0; font-size: 19px; color: var(--navy); font-weight: 800; line-height: 1.35; }
    .card-body p { margin: 0; color: var(--muted); font-size: 14.5px; flex: 1; }
    .card-link {
      color: var(--purple-deep); font-weight: 700; font-size: 14.5px;
      display: inline-flex; align-items: center; gap: 8px; margin-top: 6px;
    }
    .card-link svg { width: 15px; height: 15px; }

    /* FAQ accordion */
    .faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 28px; max-width: 1020px; margin: 0 auto; }
    .faq-grid.single { grid-template-columns: 1fr; max-width: 820px; }
    .faq-list { display: grid; gap: 14px; align-content: start; }
    .faq-list details { background: #fff; border: 1px solid var(--line); border-radius: 12px; }
    .faq-list summary {
      padding: 17px 22px; font-weight: 700; color: var(--navy); cursor: pointer;
      list-style: none; display: flex; justify-content: space-between; align-items: center;
      gap: 12px; font-size: 16px;
    }
    .faq-list summary::-webkit-details-marker { display: none; }
    .faq-list summary::after {
      content: "+"; color: var(--purple-deep); font-size: 24px; font-weight: 400; flex: none; line-height: 1;
    }
    .faq-list details[open] summary::after { content: "\2013"; }
    .faq-list .faq-answer { padding: 0 22px 20px; color: var(--muted); font-size: 15.5px; }
    .faq-list .faq-answer p { margin: 0 0 10px; }
    .faq-list .faq-answer p:last-child { margin-bottom: 0; }
    .faq-list .faq-answer a { color: var(--purple-deep); }

    /* CTA band */
    .cta-band {
      position: relative; border-radius: 32px; overflow: hidden;
      background: #fff; border: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .cta-band img.cta-bg {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; opacity: 0.5;
    }
    .cta-inner {
      position: relative; z-index: 2; text-align: center;
      padding: 84px 32px; max-width: 720px; margin: 0 auto;
    }
    .cta-inner h2 {
      font-size: 36px; color: var(--navy); font-weight: 800;
      letter-spacing: -0.6px; margin: 0 0 14px; line-height: 1.2;
    }
    .cta-inner p { color: var(--muted); font-size: 16.5px; margin: 0 0 32px; }
    .cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

    /* ---------- Inner page hero ---------- */
    .inner-hero { position: relative; background: #fff; overflow: hidden; }
    .inner-hero-grid {
      position: relative; z-index: 2;
      display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center;
      padding-block: 60px 72px;
    }
    .crumbs { font-size: 13.5px; color: var(--muted); margin: 0 0 16px; }
    .crumbs a { color: var(--muted); text-decoration: none; }
    .crumbs a:hover { color: var(--purple-deep); }
    .crumbs span { color: var(--ink); }
    .inner-hero-copy h1 {
      font-size: 44px; line-height: 1.14; letter-spacing: -0.7px;
      margin: 0 0 16px; color: var(--navy); font-weight: 800;
    }
    .inner-hero-copy p.lead { font-size: 16.5px; color: var(--muted); margin: 0 0 28px; max-width: 500px; }
    .inner-hero .hero-photo img { aspect-ratio: 4 / 3; }

    /* ---------- Prose (articles, hubs, utility) ---------- */
    .prose { max-width: 860px; margin: 0 auto; }
    .prose h2 {
      font-size: 30px; color: var(--navy); font-weight: 800; letter-spacing: -0.4px;
      margin: 52px 0 16px; scroll-margin-top: 100px;
    }
    .prose h3 { font-size: 21px; color: var(--navy); font-weight: 800; margin: 30px 0 10px; scroll-margin-top: 100px; }
    .prose p { font-size: 16.5px; line-height: 1.8; color: var(--ink); margin: 0 0 18px; }
    .prose ul, .prose ol { margin: 0 0 18px; padding-left: 22px; color: var(--ink); font-size: 16.5px; line-height: 1.8; }
    .prose li { margin-bottom: 8px; }
    .prose a { color: var(--purple-deep); }
    .disclaimer-box {
      background: #FFF9E8; border: 1px solid #EBD9A0; border-radius: 14px;
      padding: 16px 22px; font-size: 14.5px; color: #6B5B2A; margin: 0 0 28px; line-height: 1.7;
    }
    .takeaways {
      background: var(--purple-soft);
      border: 1px solid var(--purple-line);
      border-left: 5px solid var(--purple-deep);
      border-radius: 14px;
      padding: 26px 30px;
      margin: 0 0 36px;
    }
    .takeaways h2 {
      font-size: 15px; margin: 0 0 12px; color: var(--navy); font-weight: 800;
      text-transform: uppercase; letter-spacing: 1px;
    }
    .takeaways ul { margin: 0; padding-left: 20px; }
    .takeaways li { margin-bottom: 8px; font-size: 15.5px; line-height: 1.7; color: var(--ink); }
    .takeaways li:last-child { margin-bottom: 0; }

    /* Data tables */
    .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 16px; margin: 8px 0; background: #fff; }
    table.data-table { width: 100%; border-collapse: collapse; font-size: 15px; min-width: 580px; }
    .data-table thead th {
      background: var(--navy); color: #fff; text-align: left;
      padding: 14px 18px; font-size: 14px; font-weight: 700;
    }
    .data-table tbody th, .data-table tbody td {
      padding: 14px 18px; border-top: 1px solid var(--line); vertical-align: top; text-align: left;
    }
    .data-table tbody th { color: var(--navy); font-weight: 700; }
    .data-table tbody tr:nth-child(even) { background: var(--bg); }
    .table-note { font-size: 13.5px; color: var(--muted); margin: 10px 0 0; }

    /* Page body wrapper */
    .page-body { padding: 8px 0 88px; }
    .page-hero { background: #fff; padding: 64px 0 8px; }
    .page-hero h1 { font-size: 42px; color: var(--navy); margin: 0 0 14px; font-weight: 800; letter-spacing: -0.6px; }
    .page-hero p { color: var(--muted); font-size: 17px; max-width: 720px; margin: 0; }

    /* ---------- Footer ---------- */
    .site-footer { background: var(--navy); color: #B9BFD6; }
    .footer-grid {
      display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 44px;
      padding: 64px 0 44px;
    }
    .footer-brand .brand-name { color: #fff; }
    .footer-brand .brand-name span { color: var(--purple); }
    .footer-brand p { font-size: 14px; margin: 16px 0 0; max-width: 300px; line-height: 1.7; }
    .site-footer h3 { color: #fff; font-size: 15px; margin: 0 0 18px; font-weight: 700; }
    .footer-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 11px; }
    .footer-links a { color: #B9BFD6; text-decoration: none; font-size: 14px; }
    .footer-links a:hover { color: #fff; }
    .footer-disclaimer { font-size: 12.5px; line-height: 1.75; color: #8E96B8; margin: 0; }
    .footer-bottom {
      border-top: 1px solid rgba(255,255,255,0.12);
      padding: 22px 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    }
    .footer-bottom p { margin: 0; font-size: 13.5px; color: #8E96B8; }
    .footer-legal { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .footer-legal a { color: #B9BFD6; text-decoration: none; font-size: 13.5px; }
    .footer-legal a:hover { color: #fff; }
    .footer-legal span { color: #4A5570; }

    /* ---------- Responsive ---------- */
    @media (max-width: 1020px) {
      .hero-grid, .inner-hero-grid, .research-grid { grid-template-columns: 1fr; gap: 40px; }
      .hero-grid { padding-block: 56px 64px; }
      .hero-copy h1 { font-size: 42px; }
      .hero-photo img { aspect-ratio: 16 / 10; }
      .float-chip.chip-1 { left: 12px; }
      .float-chip.chip-2 { right: 12px; }
      .topic-grid, .card-grid { grid-template-columns: repeat(2, 1fr); }
      .faq-grid { grid-template-columns: 1fr; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
      .inner-hero-copy h1 { font-size: 36px; }
    }
    @media (max-width: 820px) {
      .menu-toggle { display: inline-flex; }
      .header-actions .btn { display: none; }
      .main-nav {
        display: none; position: absolute; top: 78px; left: 0; right: 0;
        background: #fff; border-bottom: 1px solid var(--line);
        box-shadow: 0 20px 30px rgba(25,27,42,0.10);
      }
      .site-header.nav-open .main-nav { display: block; }
      .main-nav ul { flex-direction: column; align-items: stretch; gap: 0; padding: 8px 24px 18px; }
      .main-nav li.has-dropdown { display: flex; flex-wrap: wrap; align-items: center; }
      .main-nav li.has-dropdown > a { flex: 1 1 auto; width: auto; }
      .main-nav > ul > li > a { padding: 13px 0; border-bottom: 1px solid var(--line); display: block; width: 100%; }
      .main-nav > ul > li > a.active::after { display: none; }
      .main-nav > ul > li > a.active { color: var(--purple-deep); }
      .sub-toggle { display: inline-flex; align-items: center; margin-right: -6px; padding: 12px 6px; }
      .main-nav li.has-dropdown.sub-open .sub-toggle svg { transform: rotate(180deg); }
      .main-nav li.has-dropdown.sub-open .sub-toggle { color: var(--purple-deep); }
      .main-nav .dropdown {
        display: none; position: static; flex: 1 1 100%;
        box-shadow: none; border: none; border-radius: 0;
        min-width: 0; padding: 0 0 0 16px; margin: 0;
      }
      .main-nav .dropdown::before { display: none; }
      .main-nav li.has-dropdown:hover > .dropdown,
      .main-nav li.has-dropdown:focus-within > .dropdown { display: none; }
      .main-nav li.has-dropdown.sub-open > .dropdown { display: block; }
      .main-nav .dropdown a { padding: 11px 0; font-size: 14px; }
      .section { padding: 60px 0; }
      .section-head h2 { font-size: 29px; }
      .topic-grid, .card-grid { grid-template-columns: 1fr; }
      .topic-card img { aspect-ratio: 16 / 10; }
      .cta-inner { padding: 56px 24px; }
      .cta-inner h2 { font-size: 29px; }
      .page-hero h1 { font-size: 32px; }
      .footer-grid { grid-template-columns: 1fr; gap: 30px; }
      .footer-bottom { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>
  <header class="site-header" id="siteHeader">
    <div class="wrap header-inner">
      <a class="brand" href="/" aria-label="Behavioral Psychology home">
        <img class="logo-img" src="/images/logo.webp" alt="Behavioral Psychology" width="900" height="288" fetchpriority="high" />
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <ul>
          {nav.map((item) => (
            <li class={item.children ? 'has-dropdown' : ''}>
              <a href={item.href} class={current === item.href || (item.href !== '/' && current.startsWith(item.href)) ? 'active' : ''}>
                {item.label}
              </a>
              {item.children && (
                <button type="button" class="sub-toggle" aria-expanded="false" aria-label={item.label + ' submenu'}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </button>
              )}
              {item.children && (
                <ul class="dropdown" aria-label={item.label + ' submenu'}>
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <div class="header-actions">
        <a class="btn btn-purple btn-sm" href="/contact/">Contact Us</a>
        <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div class="footer-brand">
          <a class="logo-badge" href="/" aria-label="Behavioral Psychology home">
            <img src="/images/logo.webp" alt="Behavioral Psychology" width="900" height="288" loading="lazy" />
          </a>
          <p>An independent educational publication explaining behavioral psychology: core ideas, degree programs, careers, and real-world applications.</p>
        </div>
        <div>
          <h3>Learn</h3>
          <ul class="footer-links">
            <li><a href="/what-is-behavioral-psychology/">What Is Behavioral Psychology?</a></li>
            <li><a href="/degrees/">Degrees and Programs</a></li>
            <li><a href="/careers/">Careers</a></li>
            <li><a href="/blog/">All Articles</a></li>
          </ul>
        </div>
        <div>
          <h3>Resources</h3>
          <ul class="footer-links">
            <li><a href="/about/">About</a></li>
            <li><a href="/author/hassam-shabbir/">About the Author</a></li>
            <li><a href="/editorial-standards/">Editorial Standards</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
        <div>
          <h3>Disclaimer</h3>
          <p class="footer-disclaimer">Content on this site is for educational purposes only and is not a substitute for professional medical or psychological advice, diagnosis, or treatment. The author is not a licensed clinician.</p>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 Behavioral Psychology. All rights reserved.</p>
        <div class="footer-legal">
          <a href="/privacy-policy/">Privacy Policy</a><span>|</span>
          <a href="/terms/">Terms of Use</a><span>|</span>
          <a href="/cookies/">Cookies</a><span>|</span>
          <a href="/disclaimer/">Disclaimer</a><span>|</span>
          <a href="/contact/">Contact</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      var header = document.getElementById('siteHeader');
      var toggle = document.getElementById('menuToggle');
      if (toggle && header) {
        toggle.addEventListener('click', function () {
          var open = header.classList.toggle('nav-open');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (!open) {
            header.querySelectorAll('li.has-dropdown.sub-open').forEach(function (li) {
              li.classList.remove('sub-open');
              var btn = li.querySelector('.sub-toggle');
              if (btn) btn.setAttribute('aria-expanded', 'false');
            });
          }
        });
      }
      document.querySelectorAll('.sub-toggle').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          var li = btn.closest('li.has-dropdown');
          if (!li) return;
          var open = li.classList.toggle('sub-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      });
    })();
  </script>
</body>
</html>
